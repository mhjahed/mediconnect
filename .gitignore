# .gitignore
cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Environment
.env
.env.*
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
acess-card.md
Addon-Doctor.md
Addon-Staff.md
cert.crt
cert.key
copyattendance.md
costindex.md
DATABASE CREDENTIALS.md
DEPLOYMENT.md
how_to_add_users.md
ID CARD.txt

# Stripe
stripe_keys.txt
EOF

# Create logs directory
mkdir -p logs
touch logs/.gitkeep

# Create media subdirectories
mkdir -p media/profile_pics media/prescriptions media/qr_codes

# Run initial migrations
python manage.py makemigrations
python manage.py migrate

# Create superuser
python manage.py createsuperuser

# Collect static files
python manage.py collectstatic --noinput

# Start development server
python manage.py runserver
